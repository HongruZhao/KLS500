  let gateGroups : Array (Array (Name × Name × String)) := #[auditGateChunk0, auditGateChunk1, auditGateChunk2, auditGateChunk3, auditGateChunk4, auditGateChunk5, auditGateChunk6, auditGateChunk7, auditGateChunk8, auditGateChunk9, auditGateChunk10, auditGateChunk11, auditGateChunk12, auditGateChunk13, auditGateChunk14, auditGateChunk15, auditGateChunk16, auditGateChunk17, auditGateChunk18]
  let gates := gateGroups.foldl (fun a b => a ++ b) #[]
  for (gate, origin, wantedKind) in gates do
    match env.find? gate with
    | some (.thmInfo _) => unless wantedKind == "theorem" do throwError "Expected other declaration kind: {gate}"
    | some (.defnInfo _) => unless wantedKind == "def" do throwError "Expected other declaration kind: {gate}"
    | some (.inductInfo _) => unless wantedKind == "inductive" do throwError "Expected other declaration kind: {gate}"
    | _ => throwError "Wrong declaration kind: {gate}"
    match env.getModuleIdxFor? gate with
    | some idx => unless env.allImportedModuleNames[idx.toNat]! == origin do
        throwError "Wrong defining module: {gate}"
    | none => throwError "Missing defining module: {gate}"
  logInfo m!"GATES_PASSED {gates.size}"
  let rows := env.constants.fold (fun acc name _ =>
    match env.getModuleIdxFor? name with
    | none => acc
    | some idx =>
      let origin := env.allImportedModuleNames[idx.toNat]!
      if origins.contains origin then acc.push (name, origin) else acc) (#[] : Array (Name × Name))
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut thms : Nat := 0
  for (name, origin) in rows.qsort (fun a b => Name.lt a.1 b.1) do
    let kind : String := match env.find? name with
      | some (.axiomInfo _) => "axiom"
      | some (.defnInfo _) => "definition"
      | some (.thmInfo _) => "theorem"
      | some (.opaqueInfo _) => "opaque"
      | some (.quotInfo _) => "quotient"
      | some (.inductInfo _) => "inductive"
      | some (.ctorInfo _) => "constructor"
      | some (.recInfo _) => "recursor"
      | none => "missing"
    let axs ← collectAxioms name
    unless (axs.filter (fun ax => !allowed.contains ax)).isEmpty do
      throwError "Nonstandard axioms in {name}: {axs}"
    if kind == "theorem" then thms := thms + 1
    logInfo m!"ORIGIN_AXIOMS {name}|{origin}|{kind}|{axs}"
  logInfo m!"ALL_ORIGINS_PASSED {rows.size}|{thms}"

