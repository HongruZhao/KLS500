import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_106 :
    (rankSymmetric128IntegralWeight (106-1) * rankSymmetric128Convolution 106 ≤ (rankSymmetric128RootAllowance 106)^2) ∧
    (((4*rankSymmetric128Parameter 106-2)*(106 : ℝ)^2+(8*rankSymmetric128Parameter 106-5)*106-2) * rankSymmetric128IntegralWeight (106-1) +
      2 * rankSymmetric128RootAllowance 106 * (106 : ℝ) ≤ rankSymmetric128Coercivity 106 * (106 : ℝ)^2 * rankSymmetric128IntegralWeight 106) ∧
    (3 ≤ 106 → ((2*(106 : ℝ)^2+3*106-2) * rankSymmetric128IntegralWeight (106-1) +
      2 * rankSymmetric128RootAllowance 106 * (106 : ℝ) ≤ (106 : ℝ)^2 * rankSymmetric128CumulantWeight 106)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

