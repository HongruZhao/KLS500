import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_114 :
    (rankSymmetric128IntegralWeight (114-1) * rankSymmetric128Convolution 114 ≤ (rankSymmetric128RootAllowance 114)^2) ∧
    (((4*rankSymmetric128Parameter 114-2)*(114 : ℝ)^2+(8*rankSymmetric128Parameter 114-5)*114-2) * rankSymmetric128IntegralWeight (114-1) +
      2 * rankSymmetric128RootAllowance 114 * (114 : ℝ) ≤ rankSymmetric128Coercivity 114 * (114 : ℝ)^2 * rankSymmetric128IntegralWeight 114) ∧
    (3 ≤ 114 → ((2*(114 : ℝ)^2+3*114-2) * rankSymmetric128IntegralWeight (114-1) +
      2 * rankSymmetric128RootAllowance 114 * (114 : ℝ) ≤ (114 : ℝ)^2 * rankSymmetric128CumulantWeight 114)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

