import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_122 :
    (rankSymmetric128IntegralWeight (122-1) * rankSymmetric128Convolution 122 ≤ (rankSymmetric128RootAllowance 122)^2) ∧
    (((4*rankSymmetric128Parameter 122-2)*(122 : ℝ)^2+(8*rankSymmetric128Parameter 122-5)*122-2) * rankSymmetric128IntegralWeight (122-1) +
      2 * rankSymmetric128RootAllowance 122 * (122 : ℝ) ≤ rankSymmetric128Coercivity 122 * (122 : ℝ)^2 * rankSymmetric128IntegralWeight 122) ∧
    (3 ≤ 122 → ((2*(122 : ℝ)^2+3*122-2) * rankSymmetric128IntegralWeight (122-1) +
      2 * rankSymmetric128RootAllowance 122 * (122 : ℝ) ≤ (122 : ℝ)^2 * rankSymmetric128CumulantWeight 122)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

