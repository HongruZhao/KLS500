import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_34 :
    (rankSymmetric128IntegralWeight (34-1) * rankSymmetric128Convolution 34 ≤ (rankSymmetric128RootAllowance 34)^2) ∧
    (((4*rankSymmetric128Parameter 34-2)*(34 : ℝ)^2+(8*rankSymmetric128Parameter 34-5)*34-2) * rankSymmetric128IntegralWeight (34-1) +
      2 * rankSymmetric128RootAllowance 34 * (34 : ℝ) ≤ rankSymmetric128Coercivity 34 * (34 : ℝ)^2 * rankSymmetric128IntegralWeight 34) ∧
    (3 ≤ 34 → ((2*(34 : ℝ)^2+3*34-2) * rankSymmetric128IntegralWeight (34-1) +
      2 * rankSymmetric128RootAllowance 34 * (34 : ℝ) ≤ (34 : ℝ)^2 * rankSymmetric128CumulantWeight 34)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

