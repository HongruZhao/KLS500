import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_42 :
    (rankSymmetric128IntegralWeight (42-1) * rankSymmetric128Convolution 42 ≤ (rankSymmetric128RootAllowance 42)^2) ∧
    (((4*rankSymmetric128Parameter 42-2)*(42 : ℝ)^2+(8*rankSymmetric128Parameter 42-5)*42-2) * rankSymmetric128IntegralWeight (42-1) +
      2 * rankSymmetric128RootAllowance 42 * (42 : ℝ) ≤ rankSymmetric128Coercivity 42 * (42 : ℝ)^2 * rankSymmetric128IntegralWeight 42) ∧
    (3 ≤ 42 → ((2*(42 : ℝ)^2+3*42-2) * rankSymmetric128IntegralWeight (42-1) +
      2 * rankSymmetric128RootAllowance 42 * (42 : ℝ) ≤ (42 : ℝ)^2 * rankSymmetric128CumulantWeight 42)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

