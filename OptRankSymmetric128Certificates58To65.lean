import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_58 :
    (rankSymmetric128IntegralWeight (58-1) * rankSymmetric128Convolution 58 ≤ (rankSymmetric128RootAllowance 58)^2) ∧
    (((4*rankSymmetric128Parameter 58-2)*(58 : ℝ)^2+(8*rankSymmetric128Parameter 58-5)*58-2) * rankSymmetric128IntegralWeight (58-1) +
      2 * rankSymmetric128RootAllowance 58 * (58 : ℝ) ≤ rankSymmetric128Coercivity 58 * (58 : ℝ)^2 * rankSymmetric128IntegralWeight 58) ∧
    (3 ≤ 58 → ((2*(58 : ℝ)^2+3*58-2) * rankSymmetric128IntegralWeight (58-1) +
      2 * rankSymmetric128RootAllowance 58 * (58 : ℝ) ≤ (58 : ℝ)^2 * rankSymmetric128CumulantWeight 58)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

