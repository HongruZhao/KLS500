import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_66 :
    (rankSymmetric128IntegralWeight (66-1) * rankSymmetric128Convolution 66 ≤ (rankSymmetric128RootAllowance 66)^2) ∧
    (((4*rankSymmetric128Parameter 66-2)*(66 : ℝ)^2+(8*rankSymmetric128Parameter 66-5)*66-2) * rankSymmetric128IntegralWeight (66-1) +
      2 * rankSymmetric128RootAllowance 66 * (66 : ℝ) ≤ rankSymmetric128Coercivity 66 * (66 : ℝ)^2 * rankSymmetric128IntegralWeight 66) ∧
    (3 ≤ 66 → ((2*(66 : ℝ)^2+3*66-2) * rankSymmetric128IntegralWeight (66-1) +
      2 * rankSymmetric128RootAllowance 66 * (66 : ℝ) ≤ (66 : ℝ)^2 * rankSymmetric128CumulantWeight 66)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

