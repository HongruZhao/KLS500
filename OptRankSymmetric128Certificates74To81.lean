import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_74 :
    (rankSymmetric128IntegralWeight (74-1) * rankSymmetric128Convolution 74 ≤ (rankSymmetric128RootAllowance 74)^2) ∧
    (((4*rankSymmetric128Parameter 74-2)*(74 : ℝ)^2+(8*rankSymmetric128Parameter 74-5)*74-2) * rankSymmetric128IntegralWeight (74-1) +
      2 * rankSymmetric128RootAllowance 74 * (74 : ℝ) ≤ rankSymmetric128Coercivity 74 * (74 : ℝ)^2 * rankSymmetric128IntegralWeight 74) ∧
    (3 ≤ 74 → ((2*(74 : ℝ)^2+3*74-2) * rankSymmetric128IntegralWeight (74-1) +
      2 * rankSymmetric128RootAllowance 74 * (74 : ℝ) ≤ (74 : ℝ)^2 * rankSymmetric128CumulantWeight 74)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

