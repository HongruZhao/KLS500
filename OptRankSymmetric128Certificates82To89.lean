import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_82 :
    (rankSymmetric128IntegralWeight (82-1) * rankSymmetric128Convolution 82 ≤ (rankSymmetric128RootAllowance 82)^2) ∧
    (((4*rankSymmetric128Parameter 82-2)*(82 : ℝ)^2+(8*rankSymmetric128Parameter 82-5)*82-2) * rankSymmetric128IntegralWeight (82-1) +
      2 * rankSymmetric128RootAllowance 82 * (82 : ℝ) ≤ rankSymmetric128Coercivity 82 * (82 : ℝ)^2 * rankSymmetric128IntegralWeight 82) ∧
    (3 ≤ 82 → ((2*(82 : ℝ)^2+3*82-2) * rankSymmetric128IntegralWeight (82-1) +
      2 * rankSymmetric128RootAllowance 82 * (82 : ℝ) ≤ (82 : ℝ)^2 * rankSymmetric128CumulantWeight 82)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

