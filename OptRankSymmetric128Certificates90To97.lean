import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_90 :
    (rankSymmetric128IntegralWeight (90-1) * rankSymmetric128Convolution 90 ≤ (rankSymmetric128RootAllowance 90)^2) ∧
    (((4*rankSymmetric128Parameter 90-2)*(90 : ℝ)^2+(8*rankSymmetric128Parameter 90-5)*90-2) * rankSymmetric128IntegralWeight (90-1) +
      2 * rankSymmetric128RootAllowance 90 * (90 : ℝ) ≤ rankSymmetric128Coercivity 90 * (90 : ℝ)^2 * rankSymmetric128IntegralWeight 90) ∧
    (3 ≤ 90 → ((2*(90 : ℝ)^2+3*90-2) * rankSymmetric128IntegralWeight (90-1) +
      2 * rankSymmetric128RootAllowance 90 * (90 : ℝ) ≤ (90 : ℝ)^2 * rankSymmetric128CumulantWeight 90)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

