import OptRankSymmetric128Weights

set_option maxRecDepth 8192

set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric128Certificate_98 :
    (rankSymmetric128IntegralWeight (98-1) * rankSymmetric128Convolution 98 ≤ (rankSymmetric128RootAllowance 98)^2) ∧
    (((4*rankSymmetric128Parameter 98-2)*(98 : ℝ)^2+(8*rankSymmetric128Parameter 98-5)*98-2) * rankSymmetric128IntegralWeight (98-1) +
      2 * rankSymmetric128RootAllowance 98 * (98 : ℝ) ≤ rankSymmetric128Coercivity 98 * (98 : ℝ)^2 * rankSymmetric128IntegralWeight 98) ∧
    (3 ≤ 98 → ((2*(98 : ℝ)^2+3*98-2) * rankSymmetric128IntegralWeight (98-1) +
      2 * rankSymmetric128RootAllowance 98 * (98 : ℝ) ≤ (98 : ℝ)^2 * rankSymmetric128CumulantWeight 98)) := by
  norm_num [rankSymmetric128Coercivity, rankSymmetric128Convolution, rankSymmetric128CauchyWeight, Finset.sum_Icc_succ_top]

