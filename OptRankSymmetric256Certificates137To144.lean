import OptRankSymmetric256Weights

set_option maxRecDepth 16384
set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric256Certificate_137 :
    (rankSymmetric256IntegralWeight (137-1) * rankSymmetric256Convolution 137 ≤ (rankSymmetric256RootAllowance 137)^2) ∧
    (((4*rankSymmetric256Parameter 137-2)*(137 : ℝ)^2+(8*rankSymmetric256Parameter 137-5)*137-2) * rankSymmetric256IntegralWeight (137-1) +
      2 * rankSymmetric256RootAllowance 137 * (137 : ℝ) ≤ rankSymmetric256Coercivity 137 * (137 : ℝ)^2 * rankSymmetric256IntegralWeight 137) ∧
    (((2*(137 : ℝ)^2+3*137-2) * rankSymmetric256IntegralWeight (137-1) +
      2 * rankSymmetric256RootAllowance 137 * (137 : ℝ) ≤ (137 : ℝ)^2 * rankSymmetric256CumulantWeight 137)) := by
  norm_num [rankSymmetric256Coercivity, rankSymmetric256Convolution, rankSymmetric256CauchyWeight,
    rankSymmetric256CauchyOffset, rankSymmetric256CauchyOffset137, Finset.sum_Icc_succ_top]

