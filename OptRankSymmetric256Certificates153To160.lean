import OptRankSymmetric256Weights

set_option maxRecDepth 16384
set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric256Certificate_153 :
    (rankSymmetric256IntegralWeight (153-1) * rankSymmetric256Convolution 153 ≤ (rankSymmetric256RootAllowance 153)^2) ∧
    (((4*rankSymmetric256Parameter 153-2)*(153 : ℝ)^2+(8*rankSymmetric256Parameter 153-5)*153-2) * rankSymmetric256IntegralWeight (153-1) +
      2 * rankSymmetric256RootAllowance 153 * (153 : ℝ) ≤ rankSymmetric256Coercivity 153 * (153 : ℝ)^2 * rankSymmetric256IntegralWeight 153) ∧
    (((2*(153 : ℝ)^2+3*153-2) * rankSymmetric256IntegralWeight (153-1) +
      2 * rankSymmetric256RootAllowance 153 * (153 : ℝ) ≤ (153 : ℝ)^2 * rankSymmetric256CumulantWeight 153)) := by
  norm_num [rankSymmetric256Coercivity, rankSymmetric256Convolution, rankSymmetric256CauchyWeight,
    rankSymmetric256CauchyOffset, rankSymmetric256CauchyOffset153, Finset.sum_Icc_succ_top]

