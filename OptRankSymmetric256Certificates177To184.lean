import OptRankSymmetric256Weights

set_option maxRecDepth 16384
set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric256Certificate_177 :
    (rankSymmetric256IntegralWeight (177-1) * rankSymmetric256Convolution 177 ≤ (rankSymmetric256RootAllowance 177)^2) ∧
    (((4*rankSymmetric256Parameter 177-2)*(177 : ℝ)^2+(8*rankSymmetric256Parameter 177-5)*177-2) * rankSymmetric256IntegralWeight (177-1) +
      2 * rankSymmetric256RootAllowance 177 * (177 : ℝ) ≤ rankSymmetric256Coercivity 177 * (177 : ℝ)^2 * rankSymmetric256IntegralWeight 177) ∧
    (((2*(177 : ℝ)^2+3*177-2) * rankSymmetric256IntegralWeight (177-1) +
      2 * rankSymmetric256RootAllowance 177 * (177 : ℝ) ≤ (177 : ℝ)^2 * rankSymmetric256CumulantWeight 177)) := by
  norm_num [rankSymmetric256Coercivity, rankSymmetric256Convolution, rankSymmetric256CauchyWeight,
    rankSymmetric256CauchyOffset, rankSymmetric256CauchyOffset177, Finset.sum_Icc_succ_top]

