import OptRankSymmetric256Weights

set_option maxRecDepth 16384
set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric256Certificate_209 :
    (rankSymmetric256IntegralWeight (209-1) * rankSymmetric256Convolution 209 ≤ (rankSymmetric256RootAllowance 209)^2) ∧
    (((4*rankSymmetric256Parameter 209-2)*(209 : ℝ)^2+(8*rankSymmetric256Parameter 209-5)*209-2) * rankSymmetric256IntegralWeight (209-1) +
      2 * rankSymmetric256RootAllowance 209 * (209 : ℝ) ≤ rankSymmetric256Coercivity 209 * (209 : ℝ)^2 * rankSymmetric256IntegralWeight 209) ∧
    (((2*(209 : ℝ)^2+3*209-2) * rankSymmetric256IntegralWeight (209-1) +
      2 * rankSymmetric256RootAllowance 209 * (209 : ℝ) ≤ (209 : ℝ)^2 * rankSymmetric256CumulantWeight 209)) := by
  norm_num [rankSymmetric256Coercivity, rankSymmetric256Convolution, rankSymmetric256CauchyWeight,
    rankSymmetric256CauchyOffset, rankSymmetric256CauchyOffset209, Finset.sum_Icc_succ_top]

