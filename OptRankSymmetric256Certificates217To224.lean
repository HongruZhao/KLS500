import OptRankSymmetric256Weights

set_option maxRecDepth 16384
set_option maxHeartbeats 16000000
noncomputable section
namespace KLS.RouteArithmetic

theorem rankSymmetric256Certificate_217 :
    (rankSymmetric256IntegralWeight (217-1) * rankSymmetric256Convolution 217 ≤ (rankSymmetric256RootAllowance 217)^2) ∧
    (((4*rankSymmetric256Parameter 217-2)*(217 : ℝ)^2+(8*rankSymmetric256Parameter 217-5)*217-2) * rankSymmetric256IntegralWeight (217-1) +
      2 * rankSymmetric256RootAllowance 217 * (217 : ℝ) ≤ rankSymmetric256Coercivity 217 * (217 : ℝ)^2 * rankSymmetric256IntegralWeight 217) ∧
    (((2*(217 : ℝ)^2+3*217-2) * rankSymmetric256IntegralWeight (217-1) +
      2 * rankSymmetric256RootAllowance 217 * (217 : ℝ) ≤ (217 : ℝ)^2 * rankSymmetric256CumulantWeight 217)) := by
  norm_num [rankSymmetric256Coercivity, rankSymmetric256Convolution, rankSymmetric256CauchyWeight,
    rankSymmetric256CauchyOffset, rankSymmetric256CauchyOffset217, Finset.sum_Icc_succ_top]

