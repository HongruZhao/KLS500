def rankSymmetric256Convolution (r : ℕ) : ℝ :=
  (∑ j ∈ Finset.Icc 1 (r-2), rankSymmetric256CauchyWeight r j) *
  (∑ j ∈ Finset.Icc 1 (r-2), rankSymmetric256IntegralWeight j*rankSymmetric256CumulantWeight (r-j)/rankSymmetric256CauchyWeight r j)

theorem rankSymmetric256Convolution_nonneg (r : ℕ) : 0 ≤ rankSymmetric256Convolution r := by
  apply mul_nonneg
  · exact Finset.sum_nonneg fun j _ => (rankSymmetric256CauchyWeight_pos r j).le
  · exact Finset.sum_nonneg fun j _ => div_nonneg
      (mul_nonneg (rankSymmetric256IntegralWeight_nonneg j) (rankSymmetric256CumulantWeight_nonneg (r-j)))
      (rankSymmetric256CauchyWeight_pos r j).le

theorem rankSymmetric256Convolution_eq_previous (r : ℕ) (hr : r ≤ 128) :
    rankSymmetric256Convolution r = rankSymmetric128Convolution r := by
  unfold rankSymmetric256Convolution rankSymmetric128Convolution
  congr 1
  · apply Finset.sum_congr rfl
    intro j hj
    exact rankSymmetric256CauchyWeight_eq_previous r j hr
  · apply Finset.sum_congr rfl
    intro j hj
    have hj' := Finset.mem_Icc.mp hj
    rw [rankSymmetric256IntegralWeight_eq_previous j (by omega),
      rankSymmetric256CumulantWeight_eq_previous (r-j) (by omega),
      rankSymmetric256CauchyWeight_eq_previous r j hr]

end KLS
