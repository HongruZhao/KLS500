import OptTwentySevenWeights

/-! Exact rational checks cover the finite range where excess supports overlap. -/
open scoped BigOperators
set_option maxHeartbeats 3000000
noncomputable section
namespace KLS

theorem twentySevenRankConvolution_bound_17 :
    ((17-2 : ℕ) : ℝ)*twentySevenRankConvolution 17 ≤ ((17 : ℝ)+2)^2 := by
  norm_num [twentySevenRankConvolution, twentySevenIntegralWeight, twentySevenCumulantWeight, Finset.sum_Icc_succ_top]

