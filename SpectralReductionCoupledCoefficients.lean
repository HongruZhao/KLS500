def coupledRankJump (d : ℕ) : ℕ :=
  if d=1 then 1 else if d=2 then 5 else if d=7 then 3 else if d=10 then 4 else if d=14 then 6 else if d=20 then 8 else if d=28 then 12 else if d=40 then 19 else if d=59 then 32 else if d=91 then 56 else if d=147 then 106 else if d=253 then 218 else d

def coupledRankWindow (d : ℕ) : ℕ :=
  if d=1 then 2 else if d=2 then 9 else if d=7 then 32 else if d=10 then 53 else if d=14 then 79 else if d=20 then 156 else if d=28 then 259 else if d=40 then 427 else if d=59 then 678 else if d=91 then 1259 else if d=147 then 2256 else if d=253 then 4061 else 10*d-1

def coupledYoungParameter (d : ℕ) : ℝ :=
  if d=1 then 2948779/20000000 else if d=2 then 16283557/6250000 else if d=7 then 40587361/100000000 else if d=10 then 11161629/25000000 else if d=14 then 35149063/50000000 else if d=20 then 40631/78125 else if d=28 then 58877967/100000000 else if d=40 then 72035941/100000000 else if d=59 then 50843571/50000000 else if d=91 then 420319/500000 else if d=147 then 87114171/100000000 else if d=253 then 107050389/100000000 else 1

