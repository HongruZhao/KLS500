def coupledRecoverySquared (d : ℕ) : ℝ := jumpRecoverySquared d (coupledRankJump d) (coupledRankWindow d+1)

def coupledRankMainCoefficient (M : ℝ) (d : ℕ) : ℝ :=
  (1+coupledYoungParameter d)*coupledRecoverySquared d*M^(coupledRankJump d)

def coupledRankWeight (M : ℝ) (d : ℕ) : ℝ := completeGeometricWindow M (coupledRankWindow d)

def coupledRankErrorCoefficient (ρ M : ℝ) (d : ℕ) : ℝ :=
  (coupledRankWindow d : ℝ)+ρ*(coupledRecoverySquared d+(coupledRecoverySquared d-1)/coupledYoungParameter d)*coupledRankWeight M d

def coupledNormalizedMain (d : ℕ) : ℝ :=
  (1+coupledYoungParameter d)*coupledRecoverySquared d/(9/2 : ℝ)^(coupledRankJump d)

def coupledNormalizedEarly (d : ℕ) : ℝ :=
  (9063/2000 : ℝ)^(d-1)*(coupledRankWindow d : ℝ)*moving256RankTaylorCoefficient d

def coupledNormalizedDefect (d : ℕ) : ℝ :=
  (9063/2000 : ℝ)^(d-1)*(coupledRecoverySquared d+(coupledRecoverySquared d-1)/coupledYoungParameter d)*
    coupledRankWeight (1007/1000) d*moving256RankTaylorCoefficient d

theorem coupledRecoverySquared_one_le (d : ℕ) : 1≤ coupledRecoverySquared d := by
  by_cases hd : d=0
  · subst d
    norm_num [coupledRecoverySquared,jumpRecoverySquared,coupledRankJump,coupledRankWindow]
  · exact (jumpRecoverySquared_gt_one (by omega : 1≤d) (coupledRankJump_pos (by omega))
      (coupledRankWindow_admissible d)).le

theorem coupledRankWeight_nonneg {M : ℝ} (hM : 0≤M) (d : ℕ) : 0 ≤ coupledRankWeight M d := by
  unfold coupledRankWeight completeGeometricWindow
  exact Finset.sum_nonneg fun i _ => mul_nonneg (completeIntervalWeight_nonneg i) (pow_nonneg hM _)

theorem coupledNormalizedEarly_nonneg (d : ℕ) : 0≤ coupledNormalizedEarly d := by
  have hb := moving256RankTaylorCoefficient_nonneg d
  unfold coupledNormalizedEarly
  positivity

theorem coupledNormalizedDefect_nonneg (d : ℕ) : 0≤ coupledNormalizedDefect d := by
  have hg := coupledRecoverySquared_one_le d
  have hg0 : 0≤ coupledRecoverySquared d := le_trans (by norm_num) hg
  have he := coupledYoungParameter_pos d
  have hw := coupledRankWeight_nonneg (M:=1007/1000) (by norm_num) d
  have hb := moving256RankTaylorCoefficient_nonneg d
  have hsub : 0≤ coupledRecoverySquared d-1 := by linarith
  unfold coupledNormalizedDefect
  positivity

theorem coupledNormalizedError_eq (ρ : ℝ) (d : ℕ) :
    coupledNormalizedEarly d+ρ*coupledNormalizedDefect d =
      (9063/2000 : ℝ)^(d-1)*coupledRankErrorCoefficient ρ (1007/1000) d*moving256RankTaylorCoefficient d := by
  unfold coupledNormalizedEarly coupledNormalizedDefect coupledRankErrorCoefficient
  ring

theorem coupledRankMainCoefficient_normalized (M : ℝ) (d : ℕ) :
    coupledRankMainCoefficient M d = coupledNormalizedMain d*((9/2)*M)^(coupledRankJump d) := by
  unfold coupledRankMainCoefficient coupledNormalizedMain
  rw [mul_pow]
  field_simp

theorem coupledRankJump_large {d : ℕ} (hd : 257≤d) : coupledRankJump d=d := by
  simp only [coupledRankJump,show d≠1 by omega,show d≠2 by omega,show d≠7 by omega,show d≠10 by omega,show d≠14 by omega,show d≠20 by omega,show d≠28 by omega,show d≠40 by omega,show d≠59 by omega,show d≠91 by omega,show d≠147 by omega,show d≠253 by omega,↓reduceIte]

theorem coupledRankWindow_large {d : ℕ} (hd : 257≤d) : coupledRankWindow d=10*d-1 := by
  simp only [coupledRankWindow,show d≠1 by omega,show d≠2 by omega,show d≠7 by omega,show d≠10 by omega,show d≠14 by omega,show d≠20 by omega,show d≠28 by omega,show d≠40 by omega,show d≠59 by omega,show d≠91 by omega,show d≠147 by omega,show d≠253 by omega,↓reduceIte]

theorem coupledYoungParameter_large {d : ℕ} (hd : 257≤d) : coupledYoungParameter d=1 := by
  simp only [coupledYoungParameter,show d≠1 by omega,show d≠2 by omega,show d≠7 by omega,show d≠10 by omega,show d≠14 by omega,show d≠20 by omega,show d≠28 by omega,show d≠40 by omega,show d≠59 by omega,show d≠91 by omega,show d≠147 by omega,show d≠253 by omega,↓reduceIte]

theorem coupledRecoverySquared_large {d : ℕ} (hd : 257≤d) :
    coupledRecoverySquared d=jumpRecoverySquared d d (10*d) := by
  simp only [coupledRecoverySquared,coupledRankJump_large hd,coupledRankWindow_large hd,
    show 10*d-1+1=10*d by omega]

theorem coupledNormalizedMain_large_le_two {d : ℕ} (hd : 257≤d) : coupledNormalizedMain d≤2 := by
  unfold coupledNormalizedMain
  rw [coupledYoungParameter_large hd,coupledRecoverySquared_large hd,coupledRankJump_large hd]
  apply (div_le_iff₀ (by positivity : (0:ℝ)<(9/2)^d)).mpr
  have hg := largeWindowRecoverySquared_le_power (L:=10) (d:=d) (by omega)
  norm_num only [Nat.cast_ofNat,show (4*((10:ℝ)-1)/((10:ℝ)-2))=9/2 by norm_num] at hg
  nlinarith

theorem coupledRankErrorCoefficient_le_polynomial {ρ M : ℝ} (hρ : 0≤ρ) (hM : 1≤M) {d : ℕ} (hd : 257≤d) :
    coupledRankErrorCoefficient ρ M d ≤ (10+500*ρ)*(d : ℝ)^3*((9/2)*M^10)^d := by
  have hh := retainedLargeWindowErrorCoefficient_le_cubic (M:=M) (δ:=ρ) hM hρ (L:=10) (d:=d) (by omega) (by omega)
  norm_num only [Nat.cast_ofNat,show (10+ρ*(10:ℝ)^3/2)=10+500*ρ by ring,
    show (4*((10:ℝ)-1)/((10:ℝ)-2))=9/2 by norm_num] at hh
  have he : coupledRankErrorCoefficient ρ M d =
      ((10*d-1:ℕ):ℝ)+ρ*movingJumpTaylorErrorCoefficient 1 d d (10*d-1)*completeGeometricWindow M (10*d-1) := by
    unfold coupledRankErrorCoefficient coupledRankWeight movingJumpTaylorErrorCoefficient
    simp only [coupledYoungParameter_large hd,coupledRecoverySquared_large hd,
      coupledRankWindow_large hd,show 10*d-1+1=10*d by omega]
  rw [he]
  convert hh using 1
  ring

theorem coupled_complete_geometric_window (q : ℕ) :
    completeGeometricWindow (1007/1000) q =
      (1000000000/343)*((q : ℝ)*(1007/1000 : ℝ)^(q+2)-(q+2 : ℝ)*(1007/1000 : ℝ)^(q+1)+(q+2 : ℝ)*(1007/1000)-q) := by
  have hh := completeGeometricWindow_identity (1007/1000 : ℝ) q
  norm_num only [show ((1007/1000 : ℝ)-1)^3=343/1000000000 by norm_num] at hh
  linarith

