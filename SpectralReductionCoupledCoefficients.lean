  by_cases h1 : d=1
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h2 : d=2
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h7 : d=7
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h10 : d=10
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h14 : d=14
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h20 : d=20
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h28 : d=28
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h40 : d=40
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h59 : d=59
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h91 : d=91
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h147 : d=147
  · subst d
    norm_num [coupledYoungParameter]
  by_cases h253 : d=253
  · subst d
    norm_num [coupledYoungParameter]
  simp only [coupledYoungParameter,h1,h2,h7,h10,h14,h20,h28,h40,h59,h91,h147,h253,↓reduceIte]
  norm_num

