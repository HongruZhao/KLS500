@[reducible] def KLS.Space : ℕ → Type :=
fun n => EuclideanSpace ℝ (Fin n)
def KLS.IsIsotropic : {n : ℕ} → MeasureTheory.Measure (KLS.Space n) → Prop :=
fun {n} μ =>
  MeasureTheory.Integrable (fun x => x) μ ∧
    ∫ (x : KLS.Space n), x ∂μ = 0 ∧
      (∀ (i j : Fin n), MeasureTheory.Integrable (fun x => x.ofLp i * x.ofLp j) μ) ∧ KLS.secondMomentMatrix μ = 1
def KLS.HasLogConcaveDensity : {n : ℕ} → MeasureTheory.Measure (KLS.Space n) → Prop :=
fun {n} μ =>
  ∃ V,
    KLS.ExtendedConvex V ∧
      (Measurable fun x => KLS.expNegPotential (V x)) ∧
        μ = MeasureTheory.MeasureSpace.volume.withDensity fun x => KLS.expNegPotential (V x)
