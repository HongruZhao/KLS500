constructor:
  KLS.admissibleMeasure.mk {n : ℕ} {μ : MeasureTheory.Measure (KLS.Space n)}
    (isProb : MeasureTheory.IsProbabilityMeasure μ) (logConcave : KLS.measureLogConcave μ)
    (isotropic : KLS.IsIsotropic μ) : KLS.admissibleMeasure μ
def KLS.measureLogConcave : {n : ℕ} → MeasureTheory.Measure (KLS.Space n) → Prop :=
fun {n} μ =>
  ∀ (E F : Set (KLS.Space n)),
    IsCompact E → IsCompact F → ∀ (t : ℝ), 0 < t → t < 1 → μ E ^ t * μ F ^ (1 - t) ≤ μ (KLS.affineSetCombination t E F)
def KLS.energy : {n : ℕ} → MeasureTheory.Measure (KLS.Space n) → (KLS.Space n → ℝ) → ENNReal :=
fun {n} μ f => ∫⁻ (x : KLS.Space n), ENNReal.ofReal (‖gradient f x‖ ^ 2) ∂μ
def KLS.variance : {n : ℕ} → MeasureTheory.Measure (KLS.Space n) → (KLS.Space n → ℝ) → ENNReal :=
fun {n} μ f => ProbabilityTheory.evariance f μ
def KLS.poincareConstants : {n : ℕ} → MeasureTheory.Measure (KLS.Space n) → Set NNReal :=
fun {n} μ => {C | ∀ (f : KLS.Space n → ℝ), KLS.LocallyLipschitzTests μ f → KLS.variance μ f ≤ ↑C * KLS.energy μ f}
def KLS.cheegerConstant : {n : ℕ} → MeasureTheory.Measure (KLS.Space n) → ENNReal :=
fun {n} μ => ⨅ A, KLS.boundaryMeasure μ ↑A / Min.min (μ ↑A) (1 - μ ↑A)
def KLS.KLSConjecture : Prop :=
∃ c,
  0 < c ∧
    ∀ (n : ℕ),
      1 ≤ n → ∀ (μ : MeasureTheory.Measure (KLS.Space n)), KLS.IsKLSMeasure μ → ENNReal.ofReal c ≤ KLS.cheegerConstant μ
