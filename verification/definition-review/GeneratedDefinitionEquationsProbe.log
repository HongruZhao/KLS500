fun {n} =>
  KLS.potentialMeasure.eq_1 : ∀ {n : ℕ} (φ : KLS.Space n → ℝ),
  KLS.potentialMeasure φ = volume.withDensity fun x => ENNReal.ofReal (Real.exp (-φ x))
fun {n} =>
  KLS.tiltLogLaplace.eq_1 : ∀ {n : ℕ} (μ : Measure (KLS.Space n)) (z : KLS.Space n),
  KLS.tiltLogLaplace μ z = Real.log (KLS.tiltPartition μ fun x => inner ℝ z x)
fun {n} =>
  KLS.tiltThirdCumulant.eq_1 : ∀ {n : ℕ} (μ : Measure (KLS.Space n)) (q f g h : KLS.Space n → ℝ),
  KLS.tiltThirdCumulant μ q f g h =
    KLS.tiltAverage μ q fun x =>
      (f x - KLS.tiltAverage μ q f) * (g x - KLS.tiltAverage μ q g) * (h x - KLS.tiltAverage μ q h)
